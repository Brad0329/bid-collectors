{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "PowerShell(Remove-Item -Recurse *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git checkout -- *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/no_redundant_cd.py\"",
            "timeout": 10,
            "statusMessage": "cd 접두사 검사"
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/no_output_filter.py\"",
            "timeout": 10,
            "statusMessage": "출력 필터 검사"
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/no_inline_python.py\"",
            "timeout": 10,
            "statusMessage": "인라인 파이썬 검사"
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/no_scratchpad_path.py\"",
            "timeout": 10,
            "statusMessage": "스크래치패드 경로 검사"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_context.py\"",
            "timeout": 10,
            "statusMessage": "plan.md 현재 Phase 주입"
          }
        ]
      }
    ]
  }
}
